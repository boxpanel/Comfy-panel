": 26, "mode": 0, "inputs": [{"name": "state", "type": "H3_CHAIN_STATE", "link": 48}, {"name": "segment", "type": "H3_CHAIN_SEGMENT", "link": 49}, {"name": "audio", "shape": 7, "type": "AUDIO", "link": 50}, {"name": "pending_review", "shape": 7, "type": "H3_REVIEW_DISPOSITION", "link": null}], "outputs": [{"name": "segment", "type": "H3_CHAIN_SEGMENT", "links": [10]}, {"name": "status", "type": "STRING", "links": null}], "title": "候选片段审核", "properties": {"Node name for S&R": "MiniMaxH3ChainReview"}, "widgets_values": [true, false, 0, false, true, "checkpointed", 1, false], "widgets_values_named": {"enabled": true, "play_notification_sound": false, "auto_continue_timeout_minutes": 0, "unload_models_while_waiting": false, "assemble_partial_on_stop": true, "partial_audio_source": "checkpointed", "candidate_count": 1, "review_each_candidate": false}}, {"id": 27, "type": "ModelAttentionBackend", "pos": [2420, 2108], "size": [360, 108], "flags": {}, "order": 9, "mode": 0, "inputs": [{"name": "model", "type": "MODEL", "link": 57}], "outputs": [{"name": "model", "type": "MODEL", "links": [2]}], "title": "模型注意力后端", "properties": {"Node name for S&R": "ModelAttentionBackend"}, "widgets_values": ["pytorch attention"], "widgets_values_named": {"attention": "pytorch attention"}}, {"id": 28, "type": "Note", "pos": [80, 180], "size": [1000, 330], "flags": {}, "order": 6, "mode": 0, "inputs": [], "outputs": [], "title": "从这里开始 • 0.7", "properties": {"Node name for S&R": "Note"}, "widgets_values": ["# 分镜长片 · H3 原生 Context Loop（纯文本长片）\n\n这是“帧级画面 + 生成音频连续”的原生长片工作流，使用已安装的 comfyui-minimaxh3-contex-loop 引擎，和“分镜工作台”的逐镜面板是两条路线。\n\n使用顺序：\n1. 在 Plan（Plan Modern / Plan Studio）里编辑 scenes；run_name 保持 storyboard_longform 才能续跑。\n2. Queue 后先看 Preflight；Review Gate 选择 Approve & continue / Retry / Reroll seed。\n3. 最后 Assemble 输出成片（默认硬切、保留生成音频）。\n\n本机适配：\n- UNET：minimax_h3_fl2va_pruned_int8_convrot.safetensors\n- CLIP：qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors\n- VAE：minimax_h3_video_vae_fp16 + minimax_h3_audio_vae_fp32\n- 默认 1280×736、5 秒/场、20 步；每个 scene 的 length=124 帧。\n- 示例提示词为英文，直接在 Plan 里替换成你的中文/英文分镜即可。\n\n需要“参考图 + 帧级连续”时，用插件自带的 Ref2V Studio 示例；本工作流是纯文本长片。\n本机没有 ffmpeg CLI，插件 Assemble 会走 PyAV 回退；若提示拼接失败，把 imageio-ffmpeg 的 ffmpeg.exe 加入 PATH。"], "widgets_values_named": {"text": "# 分镜长片 · H3 原生 Context Loop（纯文本长片）\n\n这是“帧级画面 + 生成音频连续”的原生长片工作流，使用已安装的 comfyui-minimaxh3-contex-loop 引擎，和“分镜工作台”的逐镜面板是两条路线。\n\n使用顺序：\n1. 在 Plan（Plan Modern / Plan Studio）里编辑 scenes；run_name 保持 storyboard_longform 才能续跑。\n2. Queue 后先看 Preflight；Review Gate 选择 Approve & continue / Retry / Reroll seed。\n3. 最后 Assemble 输出成片（默认硬切、保留生成音频）。\n\n本机适配：\n- UNET：minimax_h3_fl2va_pruned_int8_convrot.safetensors\n- CLIP：qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors\n- VAE：minimax_h3_video_vae_fp16 + minimax_h3_audio_vae_fp32\n- 默认 1280×736、5 秒/场、20 步；每个 scene 的 length=124 帧。\n- 示例提示词为英文，直接在 Plan 里替换成你的中文/英文分镜即可。\n\n需要“参考图 + 帧级连续”时，用插件自带的 Ref2V Studio 示例；本工作流是纯文本长片。\n本机没有 ffmpeg CLI，插件 Assemble 会走 PyAV 回退；若提示拼接失败，把 imageio-ffmpeg 的 ffmpeg.exe 加入 PATH。"}, "color": "#432", "bgcolor": "#653"}, {"id": 34, "type": "LoraLoaderModelOnly", "pos": [1800, 1050], "size": [360, 130], "flags": {}, "order": 2, "mode": 4, "inputs": [{"name": "model", "type": "MODEL", "link": 51}], "outputs": [{"name": "MODEL", "type": "MODEL", "links": [57]}], "title": "LoRA 加载器", "properties": {"Node name for S&R": "LoraLoaderModelOnly"}, "widgets_values": ["minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors", 1], "widgets_values_named": {"lora_name": "minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors", "strength_model": 1}}], "links": [[1, 3, 0, 1, 0, "H3_CHAIN_PLAN"], [2, 27, 0, 2, 0, "MODEL"], [3, 4, 0, 3, 0, "H3_CHAIN_POLICY"], [4, 1, 0, 6, 0, "H3_CHAIN_PLAN"], [5, 8, 0, 7, 0, "H3_CHAIN_MANIFEST"], [6, 6, 0, 8, 0, "H3_CHAIN_FLOW"], [7, 15, 0, 8, 1, "H3_CHAIN_STATE"], [8, 23, 0, 8, 2, "IMAGE"], [9, 13, 0, 8, 3, "LATENT"], [10, 26, 0, 8, 4, "H3_CHAIN_SEGMENT"], [11, 10, 0, 9, 0, "H3_CHAIN_MANIFEST"], [12, 1, 0, 